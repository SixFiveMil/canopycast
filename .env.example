# ElevenLabs API Key (Optional; falls back to hands-free browser Web Speech API)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Sentry DSN for Agent Tracing & Telemetry Spans
SENTRY_DSN=
ENVIRONMENT=production
